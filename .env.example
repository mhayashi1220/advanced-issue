# PostgreSQL 接続設定（.env にコピーして値を設定する）
# NODE_ENV=production のときは DB_HOST・DB_NAME・DB_USER・DB_PASSWORD が必須（未設定なら起動時にエラーで停止する）
# それ以外の環境で未設定の場合は localhost / todo_db / todo_user / パスワードなし を使う
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# 接続プールの最大接続数（1〜100、未設定時は 10）
DB_POOL_MAX=
# true のとき TLS で接続し、サーバー証明書を検証する（rejectUnauthorized: true）。未設定・false なら TLS なし
DB_SSL=
# 実行環境（本番では production を指定する）
NODE_ENV=
# API サーバーの待ち受けポート（未設定時は 3000）
PORT=
# レート制限（1分あたりのリクエスト数の上限。静的ファイルは対象外）
#   RATE_LIMIT_GLOBAL_MAX: API 全体（未設定時は 300）
#   RATE_LIMIT_WRITE_MAX : POST / PUT / DELETE（未設定時は 60）
RATE_LIMIT_GLOBAL_MAX=
RATE_LIMIT_WRITE_MAX=
